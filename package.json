{
  "name": "staffed",
  "version": "1.10.0",
  "description": "Compose and run coordinated subagent staff packs with progressive discovery, portable Markdown personas, and no runtime or dependencies.",
  "keywords": [
    "pi-agents",
    "subagent",
    "agent-orchestration",
    "product-development",
    "design",
    "research",
    "marketing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soleone/staffed.git"
  },
  "homepage": "https://github.com/Soleone/staffed#readme",
  "bugs": {
    "url": "https://github.com/Soleone/staffed/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "npm test && npm run validate",
    "test": "node --test",
    "validate": "node bin/staffed.mjs validate",
    "list": "node bin/staffed.mjs list",
    "tier": "node bin/staffed.mjs tier",
    "doctor": "node bin/staffed.mjs doctor",
    "enable": "node bin/staffed.mjs enable",
    "status": "node bin/staffed.mjs status",
    "demo": "npx -y @soleone/showcase@0.2.0 terminal --serve",
    "media:capture": "npx -y -p @soleone/showcase@0.2.0 node scripts/capture-demo.mjs"
  },
  "type": "module",
  "bin": {
    "staffed": "bin/staffed.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "agents",
    "packs",
    "catalog.json",
    "src",
    "bin",
    "models.json",
    "README.md",
    "docs"
  ]
}